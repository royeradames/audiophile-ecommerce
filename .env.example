# Test-mode only. Live sk_live_ / pk_live_ keys are refused by the app.

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Required to open /orders outside localhost.
STAFF_PASSWORD=

# Durable orders (native Next.js on Vercel only). Unset keeps orders in the
# browser, as the guest-only Sites fallback does. Vercel's Neon integration
# supplies both; migrations use the direct (unpooled) one.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Customer accounts: the central Breakthrough account. Leave unset and the
# store says "accounts coming soon". Set only where the issuer registered this
# deployment's exact callback (today: the protected Preview branch).
AUTH_BASE_URL=
AUTH_SECRET=
AUTH_ISSUER_URL=https://accounts-preview.royeradames.com/api/auth
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

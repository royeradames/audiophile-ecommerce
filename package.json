{
  "name": "audiophile-ecommerce-private",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:vercel": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node scripts/setup-coverage.mjs setup.json --root . --strict && node --experimental-strip-types --test tests/*.test.ts && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:plan": "node scripts/migrate.mjs --plan",
    "db:migrate": "node scripts/migrate.mjs",
    "test:journey": "node --experimental-strip-types tests/accounts-journey.browser.mjs",
    "test:hosted": "playwright test -c playwright.hosted.config.ts",
    "setup:doctor": "node scripts/setup-doctor.mjs check setup.json",
    "test:layout": "node tests/layout-identity.browser.mjs"
  },
  "dependencies": {
    "@royer/auth": "file:vendor/royer-auth-0.1.0-rc.4.tgz",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@tanstack/react-form": "^1.33.5",
    "@vercel/functions": "3.9.11",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.2",
    "next": "16.3.6",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
